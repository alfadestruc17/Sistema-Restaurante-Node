<%- include('_shell/_open', {
    title: 'Reportes Consolidados',
    currentAdminPage: 'reportes',
    pageCss: '/css/admin/reportes.css'
}) %>

    <div class="admin-page-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="header-icon-box">
                <i class="bi bi-file-earmark-bar-graph-fill"></i>
            </div>
            <div>
                <h1>Exportar Reportes Consolidados</h1>
                <p class="text-muted mb-0 small">Genera y descarga un único PDF detallado con el resumen de ventas y rendimiento de todos los restaurantes.</p>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Columna Izquierda: Configuración de Exportación -->
        <div class="col-md-5">
            <div class="card card-premium mb-4">
                <div class="card-header-premium">
                    <i class="bi bi-sliders me-2"></i>Parámetros de Exportación
                </div>
                <div class="card-body p-4">
                    <form id="exportForm">
                        <%
                        const meses = [
                            'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
                            'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'
                        ];
                        const currentMonth = new Date().getMonth(); // 0-11
                        // Seleccionar por defecto el mes anterior (o diciembre si estamos en enero)
                        const defaultMonthIndex = currentMonth === 0 ? 11 : currentMonth - 1;
                        const currentYear = new Date().getFullYear();
                        %>

                        <div class="mb-3">
                            <label for="tenantId" class="form-label fw-bold text-secondary">Restaurante</label>
                            <select class="form-select form-select-lg shadow-sm" id="tenantId" name="tenantId" required>
                                <option value="all">Todos los restaurantes (consolidado)</option>
                                <% (tenants || []).forEach(t => { %>
                                    <option value="<%= t.id %>"><%= t.nombre %></option>
                                <% }); %>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-secondary">Periodo a incluir</label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label for="mesDesde" class="form-label small text-muted mb-1">Mes desde</label>
                                    <select class="form-select shadow-sm" id="mesDesde" name="mesDesde" required>
                                        <% meses.forEach((m, index) => { %>
                                            <option value="<%= index + 1 %>" <%= index === defaultMonthIndex ? 'selected' : '' %>>
                                                <%= m %>
                                            </option>
                                        <% }); %>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label for="anioDesde" class="form-label small text-muted mb-1">Año desde</label>
                                    <select class="form-select shadow-sm" id="anioDesde" name="anioDesde" required>
                                        <% for (let y = currentYear; y >= currentYear - 3; y--) { %>
                                            <option value="<%= y %>" <%= y === currentYear ? 'selected' : '' %>>
                                                <%= y %>
                                            </option>
                                        <% } %>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label for="mesHasta" class="form-label small text-muted mb-1">Mes hasta</label>
                                    <select class="form-select shadow-sm" id="mesHasta" name="mesHasta" required>
                                        <% meses.forEach((m, index) => { %>
                                            <option value="<%= index + 1 %>" <%= index === defaultMonthIndex ? 'selected' : '' %>>
                                                <%= m %>
                                            </option>
                                        <% }); %>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label for="anioHasta" class="form-label small text-muted mb-1">Año hasta</label>
                                    <select class="form-select shadow-sm" id="anioHasta" name="anioHasta" required>
                                        <% for (let y = currentYear; y >= currentYear - 3; y--) { %>
                                            <option value="<%= y %>" <%= y === currentYear ? 'selected' : '' %>>
                                                <%= y %>
                                            </option>
                                        <% } %>
                                    </select>
                                </div>
                            </div>
                            <div class="form-text">Deja "Mes desde" y "Mes hasta" iguales para un reporte de un solo mes.</div>
                        </div>

                        <button type="submit" id="exportSubmitBtn" class="btn btn-premium w-100 py-3 shadow-lg mt-2">
                            <i class="bi bi-file-earmark-pdf-fill me-2 fs-5"></i>
                            <span id="exportSubmitLabel">Generar y Descargar PDF</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Columna Derecha: Restaurantes Incluidos -->
        <div class="col-md-7">
            <div class="card card-premium">
                <div class="card-header-premium d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-building me-2"></i>Restaurantes Activos</span>
                    <span class="badge bg-light text-primary rounded-pill"><%= tenants.length %> activos</span>
                </div>
                <div class="card-body p-0">
                    <div class="form-text px-3 pt-3">Haz clic en un restaurante para seleccionarlo en el formulario, o elige "Todos" para un consolidado.</div>
                    <div class="list-group list-group-flush list-group-premium" id="tenantsListPanel">
                        <% if (tenants && tenants.length > 0) { %>
                            <% tenants.forEach(t => { %>
                                <div class="list-group-item d-flex align-items-center justify-content-between p-3 tenant-pick-row" data-tenant-id="<%= t.id %>" role="button">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="restaurant-avatar">
                                            <i class="bi bi-shop fs-5"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold"><%= t.nombre %></h6>
                                            <span class="text-muted small"><%= t.slug %> · <%= t.plan_nombre || 'Sin Plan' %></span>
                                        </div>
                                    </div>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                                        <i class="bi bi-check-circle-fill me-1"></i>Activo
                                    </span>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="p-4 text-center text-muted">
                                <i class="bi bi-exclamation-triangle fs-3 text-warning d-block mb-2"></i>
                                No hay restaurantes activos registrados en el sistema.
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

<%- include('_shell/_close', {
    extraScripts: '<script src="/js/admin/jobPolling.js"></script><script src="/js/admin/reportes.js"></script>'
}) %>
