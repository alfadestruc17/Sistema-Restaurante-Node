<%- include('../_shell/_open', {
    title: 'Soporte Técnico',
    currentAdminPage: 'soporte',
    pageCss: '/css/admin/soporte.css'
}) %>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-headset me-2"></i>Gestión de Soporte Técnico</h2>
    </div>

    <div class="table-responsive p-3">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Restaurante</th>
                    <th>Usuario</th>
                    <th>Tipo</th>
                    <th>Estado</th>
                    <th>Fecha</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                <% if (tickets && tickets.length > 0) { %>
                    <% tickets.forEach(t => { %>
                        <tr>
                            <td><%= t.id %></td>
                            <td><strong><%= t.tenant_nombre || 'Desconocido' %></strong></td>
                            <td><%= t.usuario_nombre %> <br><small class="text-muted"><%= t.usuario_email %></small></td>
                            <td><span class="badge bg-secondary"><%= t.tipo.toUpperCase() %></span></td>
                            <td>
                                <select class="form-select form-select-sm status-select" data-id="<%= t.id %>" style="width: auto; display:inline-block;">
                                    <option value="abierto" <%= t.estado === 'abierto' ? 'selected' : '' %>>Abierto</option>
                                    <option value="en_proceso" <%= t.estado === 'en_proceso' ? 'selected' : '' %>>En Proceso</option>
                                    <option value="resuelto" <%= t.estado === 'resuelto' ? 'selected' : '' %>>Resuelto</option>
                                    <option value="cerrado" <%= t.estado === 'cerrado' ? 'selected' : '' %>>Cerrado</option>
                                </select>
                            </td>
                            <td><%= new Date(t.created_at).toLocaleString() %></td>
                            <td>
                                <button class="btn btn-sm btn-primary btn-responder"
                                        data-bs-toggle="modal" data-bs-target="#replyModal"
                                        data-id="<%= t.id %>"
                                        data-desc="<%= t.descripcion %>"
                                        data-resp="<%= t.respuesta_admin || '' %>"
                                        data-tenant="<%= t.tenant_nombre %>">
                                    <i class="bi bi-reply-fill"></i> Responder
                                </button>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr><td colspan="7" class="text-center py-4">No hay tickets de soporte registrados.</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <!-- Modal Responder -->
    <div class="modal fade" id="replyModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Responder Ticket #<span id="modalTicketId"></span> - <span id="modalTenantName"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <h6>Mensaje del Usuario:</h6>
                    <div class="p-3 bg-light rounded mb-3" style="white-space: pre-wrap;" id="modalTicketDesc"></div>

                    <form id="replyForm">
                        <input type="hidden" id="replyTicketId">
                        <div class="mb-3">
                            <label class="form-label">Tu Respuesta (Soporte Técnico)</label>
                            <textarea class="form-control" id="replyText" rows="6" required placeholder="Escribe tu respuesta aquí. Se enviará un correo al usuario notificándole."></textarea>
                        </div>
                        <div class="text-end">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-success" id="btnSendReply">
                                <i class="bi bi-send me-1"></i> Enviar y Marcar Resuelto
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

<%- include('../_shell/_close', {
    extraScripts: '<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script><script src="/js/admin/soporte.js"></script>'
}) %>
