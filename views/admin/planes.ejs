<%- include('_shell/_open', {
    title: 'Planes & Add-ons',
    currentAdminPage: 'planes',
    pageCss: '/css/admin/planes.css'
}) %>

    <div class="page-header d-flex align-items-center gap-3">
        <div class="header-icon-box" style="width:42px;height:42px;flex-shrink:0;">
            <i class="bi bi-layers-fill fs-5"></i>
        </div>
        <div>
            <h1>Planes &amp; Add-ons</h1>
            <p class="text-muted mb-0 small">Gestiona planes de suscripcion y modulos adicionales por
                restaurante.</p>
        </div>
        <div class="ms-auto">
            <button type="button" id="exportPortafolioBtn"
                class="btn btn-outline-danger shadow-sm border-0 bg-white">
                <i class="bi bi-file-earmark-pdf-fill me-1"></i><span id="exportPortafolioLabel">Exportar Portafolio (PDF)</span>
            </button>
        </div>
    </div>

    <ul class="nav nav-tabs" id="tabs">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabR">
                <i class="bi bi-building me-1"></i>Restaurantes
                <span class="badge bg-primary ms-1">
                    <%= tenants ? tenants.length : 0 %>
                </span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabP">
                <i class="bi bi-box me-1"></i>Planes
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabA">
                <i class="bi bi-puzzle me-1"></i>Add-ons
                <span class="badge bg-secondary ms-1">
                    <%= addons ? addons.length : 0 %>
                </span>
            </button>
        </li>
    </ul>

    <div class="tab-content">
        <!-- Tab Restaurantes -->
        <%- include('planes/_tab_restaurantes', { ...locals, tenants }) %>

        <!-- Tab Planes -->
        <%- include('planes/_tab_planes', { ...locals, plans }) %>

        <!-- Tab Add-ons -->
        <%- include('planes/_tab_addons', { ...locals, addons }) %>
    </div>

    <!-- Modales -->
    <%- include('planes/_modal_gestionar', { ...locals, addons, plans }) %>

    <script type="application/json" id="SD"><%- serverData %></script>

<%- include('_shell/_close', {
    extraScripts: '<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script><script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script><script src="/js/core/money-input.js"></script><script src="/js/admin/jobPolling.js"></script><script src="/js/admin/planes.js"></script>'
}) %>
