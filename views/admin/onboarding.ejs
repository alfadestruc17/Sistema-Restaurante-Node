<%- include('_shell/_open', {
    title: 'Onboarding',
    currentAdminPage: 'onboarding'
}) %>

    <div class="dashboard-header d-flex flex-wrap align-items-start justify-content-between gap-3">
        <div class="d-flex align-items-start gap-3">
            <div class="header-icon-box">
                <i class="bi bi-person-check"></i>
            </div>
            <div>
                <h1>Onboarding</h1>
                <p class="mb-0">Usuarios y locales creados por auto-registro, pendientes de revisión.</p>
            </div>
        </div>
    </div>

    <!-- Stats -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small text-uppercase">Usuarios pendientes</div>
                    <div class="display-6 fw-bold"><%= stats.usuariosPendientesTotal %></div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small text-uppercase">Locales pendientes</div>
                    <div class="display-6 fw-bold"><%= stats.localesPendientesTotal %></div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small text-uppercase">Locales rechazados</div>
                    <div class="display-6 fw-bold"><%= stats.localesRechazadosTotal %></div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small text-uppercase">Aprobados (30 días)</div>
                    <div class="display-6 fw-bold"><%= stats.ultimos30dias.aprobados %></div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h6 class="fw-bold mb-3">Embudo · últimos 30 días</h6>
            <div class="row g-3 text-center">
                <div class="col-3">
                    <div class="fw-bold fs-4"><%= stats.ultimos30dias.registrados %></div>
                    <div class="text-muted small">Registrados</div>
                </div>
                <div class="col-3">
                    <div class="fw-bold fs-4"><%= stats.ultimos30dias.verificados %></div>
                    <div class="text-muted small">Verificaron correo</div>
                </div>
                <div class="col-3">
                    <div class="fw-bold fs-4"><%= stats.ultimos30dias.localesCreados %></div>
                    <div class="text-muted small">Crearon su local</div>
                </div>
                <div class="col-3">
                    <div class="fw-bold fs-4"><%= stats.ultimos30dias.aprobados %></div>
                    <div class="text-muted small">Aprobados</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Locales pendientes -->
    <div class="card mb-4">
        <div class="card-header bg-transparent fw-bold">
            <i class="bi bi-shop me-2"></i>Locales pendientes de aprobación
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr class="text-muted small text-uppercase">
                        <th>Local</th>
                        <th>Creado por</th>
                        <th>Ciudad</th>
                        <th>Fecha</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody id="tbodyLocalesPendientes">
                    <% if (!localesPendientes || localesPendientes.length === 0) { %>
                        <tr><td colspan="5" class="text-center text-muted py-4">No hay locales pendientes.</td></tr>
                    <% } else { %>
                        <% localesPendientes.forEach(t => { %>
                            <tr data-id="<%= t.id %>">
                                <td>
                                    <div class="fw-semibold"><%= t.nombre %></div>
                                    <div class="text-muted small"><%= t.slug %></div>
                                </td>
                                <td>
                                    <div><%= t.creador_nombre || t.creador_username || '—' %></div>
                                    <div class="text-muted small"><%= t.creador_email || '' %></div>
                                </td>
                                <td><%= t.ciudad || '—' %></td>
                                <td><%= new Date(t.created_at).toLocaleDateString('es-CO') %></td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-success" onclick="aprobarLocal(<%= t.id %>, '<%= (t.nombre || '').replace(/'/g, "\\'") %>')">
                                        <i class="bi bi-check-lg"></i> Aprobar
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="rechazarLocal(<%= t.id %>, '<%= (t.nombre || '').replace(/'/g, "\\'") %>')">
                                        <i class="bi bi-x-lg"></i> Rechazar
                                    </button>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Usuarios pendientes -->
    <div class="card mb-4">
        <div class="card-header bg-transparent fw-bold">
            <i class="bi bi-people me-2"></i>Usuarios pendientes (sin local creado)
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr class="text-muted small text-uppercase">
                        <th>Usuario</th>
                        <th>Correo</th>
                        <th>Estado</th>
                        <th>Registrado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody id="tbodyUsuariosPendientes">
                    <% if (!usuariosPendientes || usuariosPendientes.length === 0) { %>
                        <tr><td colspan="5" class="text-center text-muted py-4">No hay usuarios pendientes.</td></tr>
                    <% } else { %>
                        <% usuariosPendientes.forEach(u => { %>
                            <tr data-id="<%= u.id %>">
                                <td>
                                    <div class="fw-semibold"><%= u.nombre_completo || u.username %></div>
                                    <div class="text-muted small">@<%= u.username %></div>
                                </td>
                                <td><%= u.email %></td>
                                <td>
                                    <% if (u.email_verificado_at) { %>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Verificado, sin local</span>
                                    <% } else { %>
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Esperando verificación</span>
                                    <% } %>
                                </td>
                                <td><%= new Date(u.created_at).toLocaleDateString('es-CO') %></td>
                                <td class="text-end">
                                    <% if (!u.email_verificado_at) { %>
                                        <button class="btn btn-sm btn-outline-secondary" onclick="reenviarVerificacion(<%= u.id %>)">
                                            <i class="bi bi-arrow-repeat"></i> Reenviar
                                        </button>
                                    <% } %>
                                    <button class="btn btn-sm btn-outline-danger" onclick="eliminarUsuarioPendiente(<%= u.id %>, '<%= (u.username || '').replace(/'/g, "\\'") %>')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

<%- include('_shell/_close', {
    extraScripts: '<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script><script src="/js/admin/onboarding.js"></script>'
}) %>
