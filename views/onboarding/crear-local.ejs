<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title || 'Crea tu local' %> - Sistema de Restaurante
    </title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="/css/auth/login.css">
    <link rel="stylesheet" href="/css/onboarding/crear-local.css">
</head>

<body>

    <!-- ── Panel izquierdo: marca + progreso ── -->
    <aside class="login-brand">
        <a href="/" class="brand-top" style="text-decoration: none;">
            <div class="brand-icon"><i class="bi bi-shop"></i></div>
            <span class="brand-name">GastroFlow</span>
        </a>

        <div class="brand-center">
            <h2 class="brand-headline">
                Ya casi <span>terminas</span>
            </h2>
            <p class="brand-sub">
                Con esto creamos tu local. Un asesor lo revisará y te avisamos
                por correo apenas quede activo.
            </p>
        </div>

        <div class="brand-features">
            <div class="feat-item" style="opacity:.45;">
                <div class="feat-icon"><i class="bi bi-check-lg"></i></div>
                Regístrate con tu correo
            </div>
            <div class="feat-item" style="opacity:.45;">
                <div class="feat-icon"><i class="bi bi-check-lg"></i></div>
                Verifica tu cuenta
            </div>
            <div class="feat-item">
                <div class="feat-icon" style="background:rgba(99,102,241,.35);border-color:#818cf8;color:#fff;">
                    <i class="bi bi-3-circle-fill"></i>
                </div>
                <strong>Crea tu local</strong>
            </div>
            <div class="feat-item" style="opacity:.45;">
                <div class="feat-icon"><i class="bi bi-4-circle"></i></div>
                Espera la aprobación y ¡listo!
            </div>
        </div>
    </aside>

    <!-- ── Panel derecho: formulario ── -->
    <main class="login-form-side">
        <div class="login-card wide">

            <a href="/" class="mobile-logo" style="text-decoration: none;">
                <div class="mobile-logo-icon"><i class="bi bi-shop"></i></div>
                <span class="mobile-logo-text">GastroFlow</span>
            </a>

            <h1 class="login-title">Crea tu local</h1>
            <p class="login-subtitle">
                Último paso: cuéntanos de tu negocio. Un asesor revisará tu solicitud
                antes de activarlo.
            </p>

            <div id="errorAlert" class="login-alert error" style="display:none;" role="alert">
                <i class="bi bi-exclamation-circle-fill"></i>
                <span id="errorMsg"></span>
            </div>

            <div class="form-card">
                <form id="crearLocalForm" autocomplete="off" novalidate>

                    <div class="field-row field-row-primary">
                        <div>
                            <label for="nombre" class="field-label">Nombre del negocio</label>
                            <div class="field-wrap">
                                <input type="text" class="field-input" id="nombre" name="nombre"
                                    placeholder="Ej: Pizzería Roma" required autofocus>
                                <i class="bi bi-shop field-icon"></i>
                            </div>
                        </div>
                        <div>
                            <label for="tipo_negocio" class="field-label">Tipo de negocio</label>
                            <div class="field-wrap field-select-wrap">
                                <select class="field-select" id="tipo_negocio" name="tipo_negocio">
                                    <option value="restaurante">🍴 Restaurante</option>
                                    <option value="comidas_rapidas">🍔 Comidas Rápidas</option>
                                    <option value="panaderia">🥯 Panadería / Repostería</option>
                                    <option value="pasteleria">🍰 Pastelería Profesional</option>
                                </select>
                                <i class="bi bi-tag field-icon"></i>
                                <i class="bi bi-chevron-down field-chevron"></i>
                            </div>
                        </div>
                    </div>

                    <div class="field-row">
                        <div>
                            <label for="ciudad" class="field-label">Ciudad</label>
                            <div class="field-wrap">
                                <input type="text" class="field-input" id="ciudad" name="ciudad" placeholder="Ciudad">
                                <i class="bi bi-geo-alt field-icon"></i>
                            </div>
                        </div>
                        <div>
                            <label for="telefono" class="field-label">Teléfono</label>
                            <div class="field-wrap">
                                <input type="text" class="field-input" id="telefono" name="telefono" placeholder="Teléfono de contacto">
                                <i class="bi bi-telephone field-icon"></i>
                            </div>
                        </div>
                    </div>

                    <div class="form-section-label">Datos opcionales</div>

                    <div class="field-row">
                        <div>
                            <label for="nit" class="field-label">NIT / Documento</label>
                            <div class="field-wrap">
                                <input type="text" class="field-input" id="nit" name="nit" placeholder="NIT o Cédula">
                                <i class="bi bi-file-earmark-text field-icon"></i>
                            </div>
                        </div>
                        <div>
                            <label for="direccion" class="field-label">Dirección</label>
                            <div class="field-wrap">
                                <input type="text" class="field-input" id="direccion" name="direccion" placeholder="Dirección">
                                <i class="bi bi-signpost field-icon"></i>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn-login" id="btnCrearLocal">
                        <i class="bi bi-check-circle"></i>
                        Crear mi local
                    </button>
                </form>
            </div>
        </div>
    </main>

    <script src="/js/onboarding/crear-local.js"></script>
</body>

</html>
