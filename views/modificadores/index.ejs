<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modificadores / Toppings</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="/css/modulos/modificadores.css">
</head>

<body>
    <%- include('../partials/navbar', { user: typeof user !=='undefined' ? user : null, tenant: typeof tenant
        !=='undefined' ? tenant : null, allowedByPlan: typeof allowedByPlan !=='undefined' ? allowedByPlan : {} }) %>

        <div class="container-fluid py-4">
            <div
                class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-3">
                <div>
                    <h1 class="h4 mb-1"><i class="bi bi-list-check me-2"></i>Modificadores / Toppings</h1>
                    <p class="text-muted small mb-0">Grupos de opciones (ej. salsas, toppings extra) que se asignan a
                        productos y se eligen al vender en POS o Mesas.</p>
                </div>
                <div class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-2">
                    <div class="search-box">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" id="buscarGrupo" class="form-control"
                                placeholder="Buscar grupo">
                        </div>
                    </div>
                    <% if (user && user.permisos && user.permisos.includes('modificadores.editar')) { %>
                        <button type="button" id="btnNuevoGrupo" class="btn btn-sm btn-primary" data-bs-toggle="modal"
                            data-bs-target="#modalGrupo">
                            <i class="bi bi-plus-lg me-1"></i> Nuevo grupo
                        </button>
                        <% } %>
                </div>
            </div>

            <%- include('_table', { grupos: typeof grupos !=='undefined' ? grupos : [] }) %>
        </div>

        <%- include('_modal_form') %>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
            <script src="/js/core/money-input.js"></script>
            <script src="/js/modulos/modificadores.js"></script>
</body>

</html>
