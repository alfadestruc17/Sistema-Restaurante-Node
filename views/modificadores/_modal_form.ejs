<!-- Modal Grupo de Modificadores -->
<div class="modal fade" id="modalGrupo" tabindex="-1">
        <div class="modal-dialog modal-lg">
                <div class="modal-content">
                        <div class="modal-header">
                                <h5 class="modal-title" id="modalGrupoTitulo">
                                        <i class="bi bi-list-check me-2"></i>Nuevo grupo de modificadores
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                                <input type="hidden" id="grupoId">

                                <div class="row">
                                        <div class="mb-3 col-md-8">
                                                <label class="form-label fw-semibold">Nombre del grupo <span
                                                                class="text-danger">*</span></label>
                                                <input type="text" class="form-control" id="grupoNombre"
                                                        placeholder="Ej: Elige tu salsa, Toppings extra">
                                        </div>
                                        <div class="mb-3 col-md-4">
                                                <label class="form-label fw-semibold">Tipo de selección</label>
                                                <select class="form-select" id="grupoTipoSeleccion">
                                                        <option value="unica">Única (radio)</option>
                                                        <option value="multiple">Múltiple (checkbox)</option>
                                                </select>
                                        </div>
                                </div>

                                <div class="mb-3">
                                        <label class="form-label fw-semibold">Descripción</label>
                                        <input type="text" class="form-control" id="grupoDescripcion"
                                                placeholder="Texto de ayuda que ve el mesero/cajero (opcional)">
                                </div>

                                <div class="row align-items-end">
                                        <div class="mb-3 col-md-3">
                                                <div class="form-check mt-4">
                                                        <input class="form-check-input" type="checkbox"
                                                                id="grupoObligatorio">
                                                        <label class="form-check-label" for="grupoObligatorio">
                                                                Obligatorio
                                                        </label>
                                                </div>
                                        </div>
                                        <div class="mb-3 col-md-4" id="grupoMinimoWrap">
                                                <label class="form-label fw-semibold">Mínimo de selecciones</label>
                                                <input type="number" min="0" class="form-control" id="grupoMinimo"
                                                        value="0">
                                        </div>
                                        <div class="mb-3 col-md-5" id="grupoMaximoWrap">
                                                <label class="form-label fw-semibold">Máximo de selecciones</label>
                                                <input type="number" min="1" class="form-control" id="grupoMaximo"
                                                        placeholder="Vacío = sin límite">
                                        </div>
                                </div>

                                <hr class="my-3">

                                <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div>
                                                <label class="form-label fw-semibold mb-0">Opciones</label>
                                                <div class="form-text mt-0">Cada opción puede tener un precio adicional
                                                        y, opcionalmente, descontar un insumo del inventario.</div>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-primary"
                                                id="btnAgregarOpcion">
                                                <i class="bi bi-plus-lg me-1"></i> Agregar opción
                                        </button>
                                </div>

                                <div class="table-responsive">
                                        <table class="table table-sm mb-0">
                                                <thead>
                                                        <tr class="table-light small text-muted">
                                                                <th>Nombre</th>
                                                                <th style="width:120px">Precio adicional</th>
                                                                <th style="width:200px">Insumo (opcional)</th>
                                                                <th style="width:100px">Cant. insumo</th>
                                                                <th style="width:60px"></th>
                                                        </tr>
                                                </thead>
                                                <tbody id="grupoOpcionesContainer"></tbody>
                                        </table>
                                </div>
                        </div>
                        <div class="modal-footer">
                                <button type="button" class="btn btn-secondary"
                                        data-bs-dismiss="modal">Cancelar</button>
                                <button type="button" class="btn btn-primary" id="btnGuardarGrupo">
                                        <i class="bi bi-check-lg me-1"></i> Guardar grupo
                                </button>
                        </div>
                </div>
        </div>
</div>
