<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error - <%= (typeof tenant !== 'undefined' && tenant) ? tenant.nombre : 'Sistema' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/core/generic.css">
</head>
<body class="eg-body">
    <div class="eg-glow" aria-hidden="true"></div>

    <div class="eg-scene" aria-hidden="true">
        <div class="eg-plate"></div>
        <div class="eg-cloche-wrap">
            <div class="eg-cloche">
                <div class="eg-cloche-dome"></div>
                <div class="eg-cloche-shine"></div>
                <div class="eg-cloche-knob"></div>
            </div>
            <div class="eg-lock-ring r1"></div>
            <div class="eg-lock-ring r2"></div>
            <div class="eg-lock-badge">
                <i class="bi bi-lock-fill"></i>
            </div>
        </div>
    </div>

    <div class="eg-content">
        <h1 class="eg-title">¡Atención!</h1>
        <p class="eg-message"><%= error.message %></p>
        <div class="eg-actions">
            <a href="javascript:history.back()" class="eg-btn">
                <i class="bi bi-arrow-left"></i>
                Regresar
            </a>
        </div>
    </div>

    <p class="eg-footer">Restaurante Node &bull; Versión 1.0.0</p>
</body>
</html>
